# Copia este archivo como .env para cambiar los valores por defecto de compose.yml
POSTGRES_DB=banco
POSTGRES_USER=banco_user
POSTGRES_PASSWORD=banco_clave

# Puerto del equipo donde se publica PostgreSQL (5433 para no chocar con un PostgreSQL local en 5432)
POSTGRES_PORT=5433
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Limite diario de retiro por cuenta, en dolares
LIMITE_DIARIO_RETIRO=1000

# Zona horaria con la que la API registra la fecha de los movimientos
ZONA_HORARIA=America/Tegucigalpa
